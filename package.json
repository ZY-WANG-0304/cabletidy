{
  "name": "cabletidy",
  "version": "0.1.0",
  "description": "A local multi-target coding CLI gateway and provider manager.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZY-WANG-0304/cabletidy.git"
  },
  "homepage": "https://github.com/ZY-WANG-0304/cabletidy#readme",
  "bugs": {
    "url": "https://github.com/ZY-WANG-0304/cabletidy/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "bin": {
    "cabletidy": "bin/cabletidy.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "web/"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:package": "node --test scripts/package-smoke.mjs",
    "test:claude": "node --test scripts/claude-smoke.mjs",
    "prepublishOnly": "npm test && npm run test:package"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "toml-eslint-parser": "^1.0.3"
  },
  "devDependencies": {
    "cross-spawn": "^7.0.6"
  }
}
